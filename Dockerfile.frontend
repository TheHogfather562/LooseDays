# Builds the static SvelteKit SPA (ssr = false, adapter-static) and serves
# it behind Caddy, which also reverse-proxies /api and /auth to the Rust
# backend — a same-origin proxy in dev, standing in for what Cloudflare
# Pages + Tunnel routing does in production.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/build /srv
COPY Caddyfile /etc/caddy/Caddyfile
