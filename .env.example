# Copy to .env and fill in — read by docker-compose to configure the Rust
# backend (postgres itself is provisioned by docker-compose.yml directly).

# A random secret used to HMAC-hash phone numbers before they're ever stored
# (see backend/src/phone.rs) — generate one with `openssl rand -hex 32`.
# Changing this later invalidates all existing phone-number matches.
SERVER_PEPPER=

# The first account allowed to sign in (bootstraps the invite-only allowlist).
# Every other person needs to be invited from inside the app (Onboarding screen)
# before they can request a magic link.
ADMIN_EMAIL=you@example.com

# Optional: send real emails via Resend (https://resend.com) instead of just
# logging the magic-link URL to the backend's console. If unset, magic links
# are logged so you can test without any email provider.
RESEND_API_KEY=
EMAIL_FROM=Loose Days <onboarding@resend.dev>

# Absolute origin used to build the magic-link URL that gets emailed out —
# must match whatever origin you actually open in your browser. Defaults to
# the full docker-compose stack's proxy port; if you're running just
# `docker compose up postgres backend` alongside `npm run dev`, change this
# to http://localhost:5173 (Vite's default dev port) instead. In production
# this is your real domain (e.g. https://loosedays.uk).
PUBLIC_ORIGIN=http://localhost:8787

# Region used to interpret phone numbers typed without a country code.
DEFAULT_PHONE_REGION=US

# Set to true once PUBLIC_ORIGIN is https:// (marks the session cookie
# Secure) — leave false for local http:// dev.
COOKIE_SECURE=false

# Optional: display name shown by browsers/authenticators when registering a
# passkey. The WebAuthn RP ID and origin aren't separately configurable —
# they're derived from PUBLIC_ORIGIN, since they have to match it exactly.
RP_NAME=Loose Days

# Only needed for docker-compose.prod.yml (self-hosting behind a Cloudflare
# Tunnel, e.g. on a NAS). Create a tunnel with the Docker connector in the
# Cloudflare Zero Trust dashboard (Networks -> Tunnels), point its public
# hostname route at http://proxy:80, and paste the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=
