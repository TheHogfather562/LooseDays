# Copy to .env and fill in for your deployment.

# Where the SQLite database file lives (created automatically on first run).
DATABASE_PATH=./data/loosedays.db

# The first account allowed to sign in (bootstraps the invite-only allowlist).
# Every other person needs to be invited from inside the app (Onboarding screen)
# before they can request a magic link.
ADMIN_EMAIL=you@example.com

# Optional: send real emails via Resend (https://resend.com) instead of just
# logging the magic-link URL to the server console. If unset, magic links are
# printed to the server logs so you can test without any email provider.
RESEND_API_KEY=
EMAIL_FROM=Loose Days <onboarding@resend.dev>
